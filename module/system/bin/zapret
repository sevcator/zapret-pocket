#!/system/bin/sh

MODPATH="/data/adb/modules/zapret"
. "$MODPATH/common.sh"

LIST_GENERAL_USER="$LIST_DIR/list-general-user.txt"
LIST_EXCLUDE_USER="$LIST_DIR/list-exclude-user.txt"
IPSET_EXCLUDE="$LIST_DIR/ipset-exclude.txt"
IPSET_FILE="$LIST_DIR/ipset-all.txt"
IPSET_BACKUP="$LIST_DIR/ipset-all.txt.bak"
IPSET_BACKUP_LEGACY="$LIST_DIR/ipset-all.txt.backup"
IPSET_FILTER_STATE="$CONFIG_DIR/ipset-filter"
IPSET_PLACEHOLDER="203.0.113.113/32"

ensure_layout
ensure_default_config

current_strategy() {
    config_value "$CURRENT_STRATEGY_FILE" "general"
}

command_info() {
    echo "zapret Pocket"
    echo "! Current strategy: $(current_strategy)"
    echo "! Current ipset filter: $(current_ipset_filter)"
    echo "  start                    - Start the zapret service"
    echo "  stop                     - Stop the zapret service"
    echo "  restart                  - Restart the zapret service"
    echo "  status                   - Print service status"
    echo "  toggle discord [on|off]  - Toggle Discord bypass for strategies"
    echo "  strategy [name]          - Show or set the current strategy"
    echo "  custom <entry>           - Add/remove custom list/ipset entry"
    echo "  exclude <entry>          - Add/remove exclude list/ipset entry"
    echo "  blocked-names <url|none> - Set/clear dnscrypt blocked-names source"
    echo "  cloaking-rules <url|none>- Set/clear dnscrypt cloaking-rules source"
    echo "  general <url|none>       - Set/clear list-general source"
    echo "  ipset-filter [mode]      - Set/cycle ipset-all mode"
    echo "  import-strategy <url>    - Download a strategy script"
}

list_strategies() {
    find "$STRATEGY_DIR" -maxdepth 1 -type f -name "*.sh" 2>/dev/null | while IFS= read -r file; do
        case "$(basename "$file")" in
            zapret.sh|make-unkillable.sh) continue ;;
        esac
        basename "$file" .sh
    done | sort
}

strategy_command() {
    case "$1" in
        ""|current|show)
            echo "! Current strategy: $(current_strategy)"
            echo "- Available strategies:"
            list_strategies
            return 0
            ;;
    esac

    if [ -f "$STRATEGY_DIR/$1.sh" ]; then
        printf '%s\n' "$1" > "$CURRENT_STRATEGY_FILE"
        echo "- Strategy set to $1"
        return 0
    fi

    echo "! Strategy not found: $1"
    return 1
}

current_ipset_filter() {
    if [ -f "$IPSET_FILTER_STATE" ] && grep -Eq '^(none|loaded|any)$' "$IPSET_FILTER_STATE" 2>/dev/null; then
        cat "$IPSET_FILTER_STATE"
        return 0
    fi

    if [ ! -s "$IPSET_FILE" ]; then
        echo "any"
        return 0
    fi

    if [ "$(wc -l < "$IPSET_FILE" 2>/dev/null | tr -d ' ')" = "1" ] && grep -Fxq "$IPSET_PLACEHOLDER" "$IPSET_FILE" 2>/dev/null; then
        echo "none"
        return 0
    fi

    echo "loaded"
}

write_ipset_filter_state() {
    printf '%s\n' "$1" > "$IPSET_FILTER_STATE"
}

backup_ipset_file() {
    [ -f "$IPSET_FILE" ] || return 0
    [ -f "$IPSET_BACKUP" ] && return 0
    cp -p "$IPSET_FILE" "$IPSET_BACKUP" >/dev/null 2>&1
}

restore_ipset_file() {
    if [ -f "$IPSET_BACKUP" ]; then
        cp -p "$IPSET_BACKUP" "$IPSET_FILE" >/dev/null 2>&1
        return $?
    fi

    if [ -f "$IPSET_BACKUP_LEGACY" ]; then
        cp -p "$IPSET_BACKUP_LEGACY" "$IPSET_BACKUP" >/dev/null 2>&1 || return 1
        cp -p "$IPSET_BACKUP" "$IPSET_FILE" >/dev/null 2>&1
        return $?
    fi

    return 1
}

set_ipset_filter_none() {
    current="$(current_ipset_filter)"
    [ "$current" = "none" ] && { echo "- IPSet filter already none"; return 0; }

    [ "$current" = "loaded" ] && backup_ipset_file
    printf '%s\n' "$IPSET_PLACEHOLDER" > "$IPSET_FILE"
    write_ipset_filter_state "none"
    echo "- IPSet filter set to none"
}

set_ipset_filter_any() {
    current="$(current_ipset_filter)"
    [ "$current" = "any" ] && { echo "- IPSet filter already any"; return 0; }

    [ "$current" = "loaded" ] && backup_ipset_file
    : > "$IPSET_FILE"
    write_ipset_filter_state "any"
    echo "- IPSet filter set to any"
}

set_ipset_filter_loaded() {
    current="$(current_ipset_filter)"
    [ "$current" = "loaded" ] && { echo "- IPSet filter already loaded"; return 0; }

    if restore_ipset_file; then
        write_ipset_filter_state "loaded"
        echo "- IPSet filter set to loaded"
        return 0
    fi

    echo "! No backup found to restore loaded ipset list"
    return 1
}

cycle_ipset_filter() {
    case "$(current_ipset_filter)" in
        loaded) set_ipset_filter_none ;;
        none)   set_ipset_filter_any ;;
        any|*)  set_ipset_filter_loaded ;;
    esac
}

set_link_file() {
    label="$1"
    target="$2"
    legacy="$3"
    value="$4"

    [ -n "$value" ] || { echo "! No URL provided"; return 1; }

    case "$value" in
        none)
            rm -f "$target" "$legacy"
            echo "- $label link removed"
            return 0
            ;;
        http://*|https://*)
            printf '%s\n' "$value" > "$target"
            rm -f "$legacy"
            echo "- $label link saved"
            return 0
            ;;
        *)
            echo "! URL must start with http:// or https://, or use none"
            return 1
            ;;
    esac
}

start_service() {
    ensure_layout
    ensure_default_config

    if service_is_running; then
        echo "- Service already running"
        return 0
    fi

    if [ ! -f "$STRATEGY_DIR/zapret.sh" ]; then
        echo "! zapret.sh not found"
        return 1
    fi

    nohup sh "$STRATEGY_DIR/zapret.sh" >/dev/null 2>&1 &
    sleep 1
    if service_is_running; then
        echo "- Service started"
        return 0
    fi

    echo "! Failed to start service"
    return 1
}

stop_service() {
    stop_module_service
    echo "- Service stopped"
}

restart_service() {
    stop_module_service
    sleep 1
    start_service
}

status_service() {
    if service_is_running; then
        echo "running"
        return 0
    fi

    echo "stopped"
    return 1
}

import_strategy() {
    url="$1"
    [ -n "$url" ] || { echo "! No URL provided"; return 1; }

    filename="${url%%\?*}"
    filename="${filename##*/}"
    [ "${filename##*.}" = "sh" ] || filename="downloaded-$(date +%Y%m%d%H%M%S).sh"

    downloader="$CURLPATH"
    [ -x "$downloader" ] || downloader="$(command -v curl 2>/dev/null)"
    [ -n "$downloader" ] || { echo "! curl not found"; return 1; }

    if "$downloader" -fsSL --retry 3 --retry-delay 1 -o "$STRATEGY_DIR/$filename" "$url"; then
        chmod 0755 "$STRATEGY_DIR/$filename" >/dev/null 2>&1 || true
        echo "- Saved as $filename"
        return 0
    fi

    echo "! Download failed"
    return 1
}

toggle_entry() {
    target_file="$1"
    entry="$2"
    tmp_file="${target_file}.tmp"

    mkdir -p "$(dirname "$target_file")"
    touch "$target_file"

    if grep -Fxq "$entry" "$target_file" 2>/dev/null; then
        grep -Fvx "$entry" "$target_file" > "$tmp_file" 2>/dev/null || true
        mv "$tmp_file" "$target_file"
        echo "- Removed"
        return 0
    fi

    printf '%s\n' "$entry" >> "$target_file"
    echo "- Added"
    return 0
}

toggle_config_flag() {
    file="$1"
    desired="$2"
    current="$(config_value "$file" "0")"

    case "$desired" in
        on|enable|1) desired="1" ;;
        off|disable|0) desired="0" ;;
        ""|toggle)
            if [ "$current" = "1" ]; then
                desired="0"
            else
                desired="1"
            fi
            ;;
        *)
            echo "! Use on, off, or no argument to toggle"
            return 1
            ;;
    esac

    printf '%s\n' "$desired" > "$file"
    echo "- Discord bypass $( [ "$desired" = "1" ] && echo enabled || echo disabled )"
    return 0
}

toggle_discord() {
    if toggle_config_flag "$BYPASS_DISCORD_FILE" "$1"; then
        if service_is_running; then
            echo "! Restart zapret to apply the Discord bypass strategy"
        fi
        return 0
    fi
    return 1
}

custom() {
    entry="$1"
    [ -z "$entry" ] && echo "! No domain/IP/CIDR provided" && return 1

    case "$entry" in
        *:*|*/*) target_file="$IPSET_EXCLUDE" ;;
        *)       target_file="$LIST_GENERAL_USER" ;;
    esac

    for file in "$LIST_DIR"/*.txt; do
        [ -f "$file" ] || continue
        [ "$file" = "$target_file" ] && continue
        if grep -Fxq "$entry" "$file" 2>/dev/null; then
            echo "! Already added in other lists, aborted"
            return 1
        fi
    done

    toggle_entry "$target_file" "$entry"
}

exclude() {
    entry="$1"
    [ -z "$entry" ] && echo "! No domain/IP/CIDR provided" && return 1

    case "$entry" in
        *:*|*/*) target_file="$IPSET_EXCLUDE" ;;
        *)       target_file="$LIST_EXCLUDE_USER" ;;
    esac

    toggle_entry "$target_file" "$entry"
}

blocked_names_link() {
    set_link_file "blocked-names" "$DNSCRYPT_BLOCKED_NAMES_LINK" "$DNSCRYPT_BLOCKED_NAMES_LINK_LEGACY" "$1"
}

cloaking_rules_link() {
    set_link_file "cloaking-rules" "$DNSCRYPT_CLOAKING_LINK" "$DNSCRYPT_CLOAKING_LINK_LEGACY" "$1"
}

general_link() {
    set_link_file "general" "$LIST_GENERAL_LINK" "$LIST_GENERAL_LINK_LEGACY" "$1"
}

ipset_filter() {
    case "$1" in
        ""|cycle) cycle_ipset_filter ;;
        none) set_ipset_filter_none ;;
        loaded) set_ipset_filter_loaded ;;
        any) set_ipset_filter_any ;;
        *)
            echo "! ipset-filter accepts none, loaded, any, or no argument to cycle"
            return 1
            ;;
    esac
}

case "$1" in
    ""|help|-help|--help|h|--h|-h) command_info ;;
    start) start_service ;;
    stop) stop_service ;;
    restart) restart_service ;;
    status) status_service ;;
    running) service_is_running ;;
    strategy) strategy_command "$2" ;;
    custom) custom "$2" ;;
    exclude) exclude "$2" ;;
    blocked-names) blocked_names_link "$2" ;;
    cloaking-rules) cloaking_rules_link "$2" ;;
    general) general_link "$2" ;;
    ipset-filter) ipset_filter "$2" ;;
    import-strategy) import_strategy "$2" ;;
    toggle)
        case "$2" in
            discord) toggle_discord "$3" ;;
            *)
                echo "! toggle accepts: discord"
                exit 1
                ;;
        esac
        ;;
    *) command_info ;;
esac
