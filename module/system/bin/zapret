#!/system/bin/sh

MODPATH="${MODPATH:-/data/adb/modules/zapret}"
. "$MODPATH/common.sh"

CLI_DEBUG="${CLI_DEBUG:-0}"

CONFIG_DIR="${CONFIG_DIR:-$MODPATH/config}"
LIST_DIR="${LIST_DIR:-$MODPATH/list}"
SERVICE_DIR="${SERVICE_DIR:-$MODPATH/.service}"
IPSET_LINK_FILE="${IPSET_LINK_FILE:-$CONFIG_DIR/ipset-link}"
LIST_GENERAL_USER_FILE="${LIST_GENERAL_USER_FILE:-$LIST_DIR/list-general-user.txt}"
LIST_EXCLUDE_USER_FILE="${LIST_EXCLUDE_USER_FILE:-$LIST_DIR/list-exclude-user.txt}"
IPSET_USER_FILE="${IPSET_USER_FILE:-$LIST_DIR/ipset-all-user.txt}"
IPSET_EXCLUDE_FILE="${IPSET_EXCLUDE_FILE:-$LIST_DIR/ipset-exclude.txt}"
IPSET_EXCLUDE_USER_FILE="${IPSET_EXCLUDE_USER_FILE:-$LIST_DIR/ipset-exclude-user.txt}"

IPSET_FILE="$LIST_DIR/ipset-all.txt"
IPSET_SERVICE_FILE="$SERVICE_DIR/ipset-service.txt"
IPSET_DEFAULT_URL="https://raw.githubusercontent.com/sevcator/zapret-lists/refs/heads/main/ipset-service.txt"
IPSET_PLACEHOLDER="203.0.113.113/32"

ensure_layout
ensure_default_config

current_strategy() {
    config_value "$CURRENT_STRATEGY_FILE" "general"
}

current_ipset_filter() {
    if [ -f "$IPSET_FILTER_STATE" ] && grep -Eq '^(none|loaded|any)$' "$IPSET_FILTER_STATE" 2>/dev/null; then
        cat "$IPSET_FILTER_STATE"
        return 0
    fi

    if [ ! -s "$IPSET_FILE" ]; then
        echo "none"
        return 0
    fi

    if [ "$(wc -l < "$IPSET_FILE" 2>/dev/null | tr -d ' ')" = "1" ] && grep -Fxq "$IPSET_PLACEHOLDER" "$IPSET_FILE" 2>/dev/null; then
        echo "loaded"
        return 0
    fi

    echo "any"
}

current_ipset_link() {
    url="$(read_link_file "$IPSET_LINK_FILE")" || url=""
    if [ -n "$url" ]; then
        printf '%s\n' "$url"
        return 0
    fi

    printf '%s\n' "$IPSET_DEFAULT_URL"
}

normalize_entry() {
    printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | tr -d '\r' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//'
}

looks_like_ip_literal() {
    printf '%s\n' "$1" | grep -Eq '^(([0-9]{1,3}(\.[0-9]{1,3}){3})|([0-9a-f:]+))$'
}

is_cidr_or_range() {
    entry="$1"

    case "$entry" in
        */*)
            base="${entry%/*}"
            mask="${entry##*/}"
            printf '%s\n' "$mask" | grep -Eq '^[0-9]{1,3}$' || return 1
            looks_like_ip_literal "$base"
            ;;
        *-*)
            left="${entry%%-*}"
            right="${entry#*-}"
            [ -n "$left" ] && [ -n "$right" ] || return 1
            looks_like_ip_literal "$left" && looks_like_ip_literal "$right"
            ;;
        *)
            return 1
            ;;
    esac
}

append_unique_line() {
    target="$1"
    entry="$2"

    mkdir -p "$(dirname "$target")"
    [ -f "$target" ] || : > "$target"

    if grep -Fxiq "$entry" "$target" 2>/dev/null; then
        return 1
    fi

    printf '%s\n' "$entry" >> "$target"
}

append_unique_nonempty_lines() {
    source_file="$1"
    target_file="$2"

    [ -f "$source_file" ] || return 0

    while IFS= read -r line || [ -n "$line" ]; do
        line="$(normalize_entry "$line")"
        [ -n "$line" ] || continue
        grep -Fxiq "$line" "$target_file" 2>/dev/null || printf '%s\n' "$line" >> "$target_file"
    done < "$source_file"
}

download_ipset_service_cache() {
    url="$(current_ipset_link)"
    debug_log "ipset_update using URL: $url"

    mkdir -p "$SERVICE_DIR"
    if download_file "$url" "$IPSET_SERVICE_FILE"; then
        return 0
    fi

    echo "! Failed to download IPSet service list"
    echo "! URL: $url"
    return 1
}

rebuild_ipset_file_for_mode() {
    mode="$1"
    tmp_file="$SERVICE_DIR/ipset-all.build.$$"

    : > "$tmp_file" || return 1

    case "$mode" in
        none)
            ;;
        loaded)
            printf '%s\n' "$IPSET_PLACEHOLDER" >> "$tmp_file"
            ;;
        any)
            if [ ! -s "$IPSET_SERVICE_FILE" ]; then
                echo "- IPSet service cache is empty, downloading..."
                if debug_enabled; then
                    download_ipset_service_cache || {
                        rm -f "$tmp_file"
                        return 1
                    }
                else
                    download_ipset_service_cache >/dev/null || {
                        rm -f "$tmp_file"
                        return 1
                    }
                fi
            fi
            [ -f "$IPSET_SERVICE_FILE" ] || {
                echo "! IPSet service list not found: $IPSET_SERVICE_FILE"
                rm -f "$tmp_file"
                return 1
            }
            append_unique_nonempty_lines "$IPSET_SERVICE_FILE" "$tmp_file"
            ;;
        *)
            echo "! Unknown ipset filter mode: $mode"
            rm -f "$tmp_file"
            return 1
            ;;
    esac

    append_unique_nonempty_lines "$IPSET_USER_FILE" "$tmp_file"

    if [ -s "$tmp_file" ]; then
        cat "$tmp_file" > "$IPSET_FILE" || {
            echo "! Failed to write active ipset list"
            rm -f "$tmp_file"
            return 1
        }
    else
        : > "$IPSET_FILE"
    fi

    rm -f "$tmp_file"
    return 0
}

show_user_entries() {
    label_one="$1"
    file_one="$2"
    label_two="$3"
    file_two="$4"

    echo "$label_one ($(basename "$file_one"))"
    if [ -s "$file_one" ]; then
        cat "$file_one"
    else
        echo "  (empty)"
    fi

    echo "$label_two ($(basename "$file_two"))"
    if [ -s "$file_two" ]; then
        cat "$file_two"
    else
        echo "  (empty)"
    fi
}

add_user_entries() {
    list_target="$1"
    ipset_target="$2"
    shift 2

    [ $# -gt 0 ] || {
        echo "! Missing entries"
        return 1
    }

    ensure_runtime_files

    added_any=0
    ipset_changed=0
    mode_before="$(current_ipset_filter)"

    for raw_entry in "$@"; do
        entry="$(normalize_entry "$raw_entry")"
        [ -n "$entry" ] || continue

        if is_cidr_or_range "$entry"; then
            target="$ipset_target"
        else
            target="$list_target"
        fi

        if append_unique_line "$target" "$entry"; then
            echo "- Added to $(basename "$target"): $entry"
            added_any=1
            [ "$target" = "$IPSET_USER_FILE" ] && ipset_changed=1
        else
            echo "- Already in $(basename "$target"): $entry"
        fi
    done

    [ "$added_any" = "1" ] || return 0

    if [ "$ipset_changed" = "1" ]; then
        rebuild_ipset_file_for_mode "$mode_before" || return 1
        write_ipset_filter_state "$mode_before"
    fi

    if service_is_running; then
        echo "! Restart zapret to apply list changes"
    fi
}

custom_command() {
    case "$1" in
        ""|list|show)
            ensure_runtime_files
            show_user_entries "Custom domains/IPs" "$LIST_GENERAL_USER_FILE" "Custom CIDR/ranges" "$IPSET_USER_FILE"
            ;;
        *)
            add_user_entries "$LIST_GENERAL_USER_FILE" "$IPSET_USER_FILE" "$@"
            ;;
    esac
}

exclude_command() {
    case "$1" in
        ""|list|show)
            ensure_runtime_files
            show_user_entries "Exclude domains/IPs" "$LIST_EXCLUDE_USER_FILE" "Exclude CIDR/ranges" "$IPSET_EXCLUDE_USER_FILE"
            ;;
        *)
            add_user_entries "$LIST_EXCLUDE_USER_FILE" "$IPSET_EXCLUDE_USER_FILE" "$@"
            ;;
    esac
}

search_command() {
    [ $# -gt 0 ] || {
        echo "! Usage: zapret search <entry> [entry ...]"
        return 1
    }

    ensure_runtime_files

    found_any=0
    search_files="
$LIST_DIR/list-general.txt
$LIST_GENERAL_USER_FILE
$IPSET_FILE
$IPSET_USER_FILE
$LIST_DIR/list-exclude.txt
$LIST_EXCLUDE_USER_FILE
$IPSET_EXCLUDE_FILE
$IPSET_EXCLUDE_USER_FILE
"

    for raw_entry in "$@"; do
        entry="$(normalize_entry "$raw_entry")"
        [ -n "$entry" ] || continue

        entry_found=0
        echo "? $entry"

        printf '%s\n' "$search_files" | while IFS= read -r file; do
            [ -n "$file" ] || continue
            [ -f "$file" ] || continue

            matches="$(grep -Finx "$entry" "$file" 2>/dev/null || true)"
            [ -n "$matches" ] || continue

            printf '%s\n' "$matches" | while IFS= read -r match; do
                line_no="${match%%:*}"
                echo "  - $(basename "$file"):$line_no"
            done
        done

        for file in "$LIST_DIR/list-general.txt" "$LIST_GENERAL_USER_FILE" "$IPSET_FILE" "$IPSET_USER_FILE" "$LIST_DIR/list-exclude.txt" "$LIST_EXCLUDE_USER_FILE" "$IPSET_EXCLUDE_FILE" "$IPSET_EXCLUDE_USER_FILE"; do
            [ -f "$file" ] || continue
            if grep -Finx "$entry" "$file" >/dev/null 2>&1; then
                entry_found=1
                found_any=1
            fi
        done

        [ "$entry_found" = "1" ] || echo "  - Not found"
    done

    [ "$found_any" = "1" ]
}

apply_ipset_filter_mode() {
    mode="$(current_ipset_filter)"

    rm -f "$LIST_DIR"/*.bak "$LIST_DIR"/*.backup 2>/dev/null || true

    rebuild_ipset_file_for_mode "$mode" || return 1

    write_ipset_filter_state "$mode"
    return 0
}

ipset_update() {
    if download_ipset_service_cache; then
        echo "- IPSet service list updated"

        if [ "$(current_ipset_filter)" = "any" ]; then
            rebuild_ipset_file_for_mode "any" || {
                echo "! Failed to refresh active ipset-all.txt"
                return 1
            }
            echo "- Active ipset-all.txt refreshed"
        fi

        if service_is_running; then
            echo "! Restart zapret to apply ipset changes"
        fi
        return 0
    fi

    return 1
}

current_interface_only() {
    if [ -f "$INTERFACE_ONLY_FILE" ]; then
        val="$(cat "$INTERFACE_ONLY_FILE" 2>/dev/null | tr -d '\r' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
        [ -n "$val" ] && printf '%s\n' "$val" || echo "all"
    else
        echo "all"
    fi
}

command_info() {
    echo "zapret Pocket"
    echo "  usage: zapret [--debug] <command>"
    echo "! Current strategy: $(current_strategy)"
    echo "! Current ipset filter: $(current_ipset_filter)"
    echo "! Current interface-only: $(current_interface_only)"
    echo "  start                              - Start the zapret service"
    echo "  stop                               - Stop the zapret service"
    echo "  restart                            - Restart the zapret service"
    echo "  status                             - Print service status"
    echo "  strategy                           - Show strategies and prompt for selection"
    echo "  import-strategy <url>              - Download a strategy script"
    echo "  test [url1 url2 ...]               - Test all strategies via curl and report the best"
    echo "  ipset-update                       - Download ipset-service.txt into service cache"
    echo "  custom [entry1 entry2 ...]         - Add custom domains/IPs or CIDR/ranges"
    echo "  custom list                        - Show custom user lists"
    echo "  exclude [entry1 entry2 ...]        - Add exclude domains/IPs or CIDR/ranges"
    echo "  exclude list                       - Show exclude user lists"
    echo "  search <entry1 entry2 ...>         - Search entries across zapret lists"
    echo "  setup bypass-calls [1|0]           - Enable or disable bypass calls"
    echo "  setup ipset-filter [none|loaded|any] - Set ipset-all mode"
    echo "  setup ipset-link [none|url]        - Set ipset-service source"
    echo "  setup cloaking-rules [none|url]    - Set dnscrypt cloaking-rules source"
    echo "  setup blocked-names [none|url]     - Set dnscrypt blocked-names source"
    echo "  setup list-general [none|url]      - Set list-general source"
    echo "  setup interface-only [none|iface[,iface...]] - Restrict iptables rules to interface(s)"
}

list_strategies() {
    find "$STRATEGY_DIR" -maxdepth 1 -type f -name "*.sh" 2>/dev/null | while IFS= read -r file; do
        case "$(basename "$file")" in
            zapret.sh|make-unkillable.sh) continue ;;
        esac
        basename "$file" .sh
    done | sort
}

strategy_command() {
    current="$(current_strategy)"
    echo "! Current strategy: $current"
    echo "- Available strategies:"
    list_strategies

    if [ -n "$1" ]; then
        echo "! strategy takes no arguments"
        echo "! Use the interactive prompt instead"
        return 1
    fi

    printf '%s' "Select strategy name: " >&2
    IFS= read -r selected || selected=""
    selected="$(printf '%s' "$selected" | tr -d '\r' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"

    [ -n "$selected" ] || {
        echo "! No strategy selected"
        return 1
    }

    if [ -f "$STRATEGY_DIR/$selected.sh" ]; then
        printf '%s\n' "$selected" > "$CURRENT_STRATEGY_FILE"
        echo "- Strategy set to $selected"
        return 0
    fi

    echo "! Strategy not found: $selected"
    return 1
}

write_ipset_filter_state() {
    printf '%s\n' "$1" > "$IPSET_FILTER_STATE"
}

set_ipset_filter_none() {
    current="$(current_ipset_filter)"
    if [ "$current" = "none" ]; then
        write_ipset_filter_state "none"
        echo "- IPSet filter already none"
        return 0
    fi

    rebuild_ipset_file_for_mode "none" || return 1
    write_ipset_filter_state "none"
    echo "- IPSet filter set to none"
}

set_ipset_filter_any() {
    current="$(current_ipset_filter)"
    if [ "$current" = "any" ]; then
        write_ipset_filter_state "any"
        echo "- IPSet filter already any"
        return 0
    fi

    rebuild_ipset_file_for_mode "any" || return 1
    write_ipset_filter_state "any"
    echo "- IPSet filter set to any"
}

set_ipset_filter_loaded() {
    current="$(current_ipset_filter)"
    if [ "$current" = "loaded" ]; then
        write_ipset_filter_state "loaded"
        echo "- IPSet filter already loaded"
        return 0
    fi

    rebuild_ipset_file_for_mode "loaded" || return 1
    write_ipset_filter_state "loaded"
    echo "- IPSet filter set to loaded"
}

set_link_file() {
    label="$1"
    target="$2"
    value="$3"

    [ -n "$value" ] || { echo "! No value provided"; return 1; }
    [ -n "$target" ] || { echo "! Internal error: empty target path for $label"; return 1; }

    case "$value" in
        none)
            rm -f "$target"
            echo "- $label removed"
            return 0
            ;;
        http://*|https://*)
            mkdir -p "$(dirname "$target")"
            printf '%s\n' "$value" > "$target"
            echo "- $label saved"
            return 0
            ;;
        *)
            echo "! Value must be none or an http(s) URL"
            return 1
            ;;
    esac
}

set_boolean_file() {
    label="$1"
    target="$2"
    value="$3"

    case "$value" in
        0|1)
            mkdir -p "$(dirname "$target")"
            printf '%s\n' "$value" > "$target"
            echo "- $label set to $value"
            return 0
            ;;
        *)
            echo "! Value must be 1 or 0"
            return 1
            ;;
    esac
}

module_stack_is_running() {
    service_is_running || return 1
    nfqws_is_running || return 1
    dnscrypt_supervisor_is_running || return 1
    dnscrypt_is_running || return 1
    return 0
}

start_service() {
    ensure_layout
    ensure_default_config
    ensure_runtime_files
    refresh_linked_lists
    apply_ipset_filter_mode || return 1

    started_any=0

    if [ ! -f "$ZAPRET_DIR/zapret.sh" ]; then
        echo "! zapret.sh not found"
        return 1
    fi

    if [ ! -f "$DNSCRYPT_DIR/dnscrypt.sh" ]; then
        echo "! dnscrypt.sh not found"
        return 1
    fi

    if [ ! -x "$DNSCRYPT_DIR/dnscrypt-proxy" ]; then
        echo "! dnscrypt-proxy not found"
        return 1
    fi

    if module_stack_is_running; then
        echo "- Service already running"
        return 0
    fi

    if service_is_running || nfqws_is_running || dnscrypt_supervisor_is_running || dnscrypt_is_running; then
        echo "! Detected degraded state, cleaning up before start"
        stop_module_service
        sleep 1
    fi

    if ! service_is_running; then
        if debug_enabled; then
            debug_log "starting strategy runner in foreground-attached background mode"
            CLI_DEBUG=1 sh "$ZAPRET_DIR/zapret.sh" &
        else
            nohup sh "$ZAPRET_DIR/zapret.sh" >/dev/null 2>&1 &
        fi
        started_any=1
    fi

    if ! dnscrypt_supervisor_is_running || ! dnscrypt_is_running; then
        if debug_enabled; then
            debug_log "starting dnscrypt runner in foreground-attached background mode"
            CLI_DEBUG=1 sh "$DNSCRYPT_DIR/dnscrypt.sh" &
        else
            nohup sh "$DNSCRYPT_DIR/dnscrypt.sh" >/dev/null 2>&1 &
        fi
        started_any=1
    fi

    sleep 2
    if module_stack_is_running; then
        if [ "$started_any" = "1" ]; then
            echo "- Service started"
        else
            echo "- Service already running"
        fi
        return 0
    fi

    echo "! Failed to start module stack"
    return 1
}

stop_service() {
    stop_module_service
    echo "- Service stopped"
}

restart_service() {
    stop_module_service
    sleep 1
    start_service
}

status_service() {
    if module_stack_is_running; then
        echo "running"
        return 0
    fi

    if service_is_running || nfqws_is_running || dnscrypt_supervisor_is_running || dnscrypt_is_running; then
        echo "degraded"
        return 1
    fi

    echo "stopped"
    return 1
}

import_strategy() {
    url="$1"
    [ -n "$url" ] || { echo "! No URL provided"; return 1; }

    filename="${url%%\?*}"
    filename="${filename##*/}"
    [ "${filename##*.}" = "sh" ] || filename="downloaded-$(date +%Y%m%d%H%M%S).sh"
    case "$filename" in
        zapret.sh|make-unkillable.sh)
            echo "! Reserved filename"
            return 1
            ;;
    esac

    debug_log "import_strategy URL: $url"
    if download_file "$url" "$STRATEGY_DIR/$filename"; then
        chmod 0755 "$STRATEGY_DIR/$filename" >/dev/null 2>&1 || true
        echo "- Saved as $filename"
        return 0
    fi

    echo "! Download failed"
    return 1
}

setup_command() {
    key="$1"
    value="$2"
    extra="$3"

    [ -n "$key" ] || { command_info; return 1; }
    [ -n "$value" ] || { echo "! Missing value for setup $key"; return 1; }

    # interface-only accepts a comma-separated value as a single argument (no extra check)
    if [ "$key" != "interface-only" ]; then
        [ -z "$extra" ] || { echo "! Too many arguments for setup $key"; return 1; }
    fi

    case "$key" in
        bypass-calls)
            set_boolean_file "bypass-calls" "$BYPASS_CALLS_FILE" "$value" || return 1
            ;;
        ipset-filter)
            case "$value" in
                none) set_ipset_filter_none || return 1 ;;
                loaded) set_ipset_filter_loaded || return 1 ;;
                any) set_ipset_filter_any || return 1 ;;
                *)
                    echo "! ipset-filter must be one of: none, loaded, any"
                    return 1
                    ;;
            esac
            ;;
        ipset-link)
            set_link_file "ipset-link" "$IPSET_LINK_FILE" "$value" || return 1
            ;;
        cloaking-rules)
            set_link_file "cloaking-rules" "$DNSCRYPT_CLOAKING_LINK" "$value" || return 1
            ;;
        blocked-names)
            set_link_file "blocked-names" "$DNSCRYPT_BLOCKED_NAMES_LINK" "$value" || return 1
            ;;
        list-general)
            set_link_file "list-general" "$LIST_GENERAL_LINK" "$value" || return 1
            ;;
        interface-only)
            case "$value" in
                none)
                    rm -f "$INTERFACE_ONLY_FILE"
                    echo "- interface-only removed (all interfaces)"
                    ;;
                *)
                    # Validate: must look like interface names (alphanumeric, _, comma)
                    _ifaces_clean="$(printf '%s' "$value" | tr ',' '\n' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//' | grep -v '^$')"
                    if [ -z "$_ifaces_clean" ]; then
                        echo "! No valid interface names provided"
                        return 1
                    fi
                    # Normalize to comma-separated and save
                    _ifaces_norm="$(printf '%s' "$_ifaces_clean" | tr '\n' ',' | sed 's/,$//')"
                    mkdir -p "$(dirname "$INTERFACE_ONLY_FILE")"
                    printf '%s\n' "$_ifaces_norm" > "$INTERFACE_ONLY_FILE"
                    echo "- interface-only set to: $_ifaces_norm"
                    ;;
            esac
            ;;
        *)
            echo "! Unknown setup key: $key"
            return 1
            ;;
    esac

    if service_is_running; then
        echo "! Restart zapret to apply setup changes"
    fi
}

## ---------------------------------------------------------------------------
# test subcommand
# Strategy tester:
#   • Three curl probes per URL: HTTP/1.1, TLS 1.2, TLS 1.3
#   • Status per probe: OK / ERR / UNSUP / SSL / DNS
#   • tcp16-20 checks: POST 64KB body + HEAD huge URI per host (suite.v2.json)
#   • tcp16-20 threshold checks: download >= N bytes (suite.json)
#   • Best strategy: max total score (HTTP_OK + DPI_BYPASSED + THRESHOLD_OK)
# ---------------------------------------------------------------------------

# Default URL targets (HTTP/TLS checks)
TEST_TARGET_URLS="
https://discord.com
https://gateway.discord.gg
https://cdn.discordapp.com
https://updates.discord.com
https://www.youtube.com
https://youtu.be
https://i.ytimg.com
https://redirector.googlevideo.com
https://soundcloud.com/versions.json
"

# ---------------------------------------------------------------------------
# _curl_probe <url> <tls_flag>
#   tls_flag: ""=HTTP/1.1  "12"=TLS1.2  "13"=TLS1.3
# Prints: STATUS|DETAIL
# STATUS: OK | ERR | UNSUP | SSL | DNS
#
# Separates stderr from stdout to avoid mixed classification:
#   stdout holds the HTTP code (-w '%{http_code}'), stderr holds error text.
# ---------------------------------------------------------------------------
_curl_probe() {
    _cp_url="$1"
    _cp_tls="$2"

    case "$_cp_tls" in
        12) _extra="--tlsv1.2 --tls-max 1.2" ;;
        13) _extra="--tlsv1.3" ;;
        *)  _extra="--http1.1" ;;
    esac

    # stdout: HTTP code via -w; stderr mixed in via 2>&1 for error classification.
    # The separator between STATUS and DETAIL is '@' (not '|') — mksh with
    # extglob treats '|' in %% patterns as an OR operator, breaking extraction.
    # shellcheck disable=SC2086
    _cp_out="$($TEST_CURL -IsS -m 8 -o /dev/null -w '%{http_code}' --show-error \
        $_extra "$_cp_url" 2>&1)"
    _cp_exit=$?
    _cp_detail="$(printf '%s' "$_cp_out" | tr '\r\n' '  ' | sed 's/[[:space:]][[:space:]]*/ /g;s/^ //;s/ $//')"
    [ -n "$_cp_detail" ] || _cp_detail="exit=$_cp_exit"

    case "$_cp_out" in
        *"not supported"*|*"does not support"*|*"unsupported protocol"*|\
        *"Unrecognized option"*|*"Unknown option"*|*"unsupported option"*|\
        *"unsupported feature"*|*"schannel"*)
            printf 'UNSUP@%s' "$_cp_detail"
            return
            ;;
    esac

    case "$_cp_out" in
        *"Could not resolve host"*|*"Name or service not known"*|\
        *"Temporary failure in name resolution"*|*"Could not resolve"*)
            printf 'DNS@%s' "$_cp_detail"
            return
            ;;
    esac

    case "$_cp_out" in
        *"certificate"*|*"SSL certificate"*|*"self-signed"*|*"self signed"*|\
        *"certificate verify failed"*|*"unable to get local issuer"*)
            printf 'SSL@%s' "$_cp_detail"
            return
            ;;
    esac

    if [ "$_cp_exit" -eq 0 ]; then
        printf 'OK@%s' "$_cp_detail"
    else
        printf 'ERR@%s' "$_cp_detail"
    fi
}

# ---------------------------------------------------------------------------
# _ping_probe <host>  → avg ms or "Timeout"
# ---------------------------------------------------------------------------
_ping_probe() {
    _pp_host="$1"
    # -c 2 sends 2 packets. -q makes it quiet except for summary line.
    _pp_out="$(ping -c 2 -W 1 -q "$_pp_host" 2>/dev/null | tail -1)"
    case "$_pp_out" in
        *avg*|*min*|*mdev*)
            _pp_avg="$(printf '%s' "$_pp_out" | sed -n 's|.*=[[:space:]]*[0-9.]*/\([0-9.]*\)/.*|\1|p')"
            [ -n "$_pp_avg" ] && printf '%s ms' "$_pp_avg" || printf 'Timeout'
            ;;
        *)
            printf 'Timeout' ;;
    esac
}

test_command() {
    NFQWS_BIN="$ZAPRET_DIR/nfqws"
    TEST_RESULT_DIR="$RUN_DIR/test"
    DNSCRYPT_STARTED_BY_TEST=0
    TEST_RESTORE_STACK=0
    TEST_DEBUG="${CLI_DEBUG:-0}"
    TEST_CLEANUP_DONE=0
    TEST_NO_STOP=0
    HAS_IP6_NFQUEUE=0
    PRECHECK_HTTPS_STATUS=""
    PRECHECK_HTTPS_DETAIL=""
    PRECHECK_HOST_PING=""
    PRECHECK_IP_PING=""

    cleanup_test_runtime() {
        [ "$TEST_CLEANUP_DONE" = "1" ] && return 0
        TEST_CLEANUP_DONE=1
        cleanup_zapret_firewall 2>/dev/null || true
        rm -f "$RESULT_FILE" "$TEST_DEBUG_LOG".tmp 2>/dev/null || true
        if [ "$DNSCRYPT_STARTED_BY_TEST" = "1" ]; then
            echo "- Stopping DNSCrypt started for test"
            terminate_pidfile_gracefully "$DNSCRYPT_SUP_PID_FILE"
            terminate_pidfile_gracefully "$DNSCRYPT_PID_FILE"
            pkill -TERM -f "$MODPATH/dnscrypt/dnscrypt.sh" >/dev/null 2>&1 || true
            pkill -TERM -x dnscrypt-proxy >/dev/null 2>&1 || true
            sleep 1
            pkill -KILL -f "$MODPATH/dnscrypt/dnscrypt.sh" >/dev/null 2>&1 || true
            pkill -KILL -x dnscrypt-proxy >/dev/null 2>&1 || true
            cleanup_dnscrypt_firewall
            restore_dnscrypt_runtime_tweaks
        fi
        if [ "$TEST_RESTORE_STACK" = "1" ]; then
            echo "- Restoring previously running service stack"
            start_service >/dev/null 2>&1 || echo "! Failed to restore service stack automatically"
        fi
    }

    on_test_signal() {
        echo ""
        echo "! Test interrupted"
        cleanup_test_runtime
        exit 130
    }

    trap on_test_signal INT TERM

    # Resolve a working curl binary (uses resolve_downloader from common.sh,
    # which probes all known locations and validates ABI compatibility).
    TEST_CURL="$(resolve_downloader 2>/dev/null)"
    if [ -z "$TEST_CURL" ]; then
        echo "! curl not found or not functional (checked: $MODPATH/curl and system paths)"
        return 1
    fi
    echo "- Using curl: $TEST_CURL"
    [ -x "$NFQWS_BIN" ] || { echo "! nfqws binary not found: $NFQWS_BIN"; return 1; }
    [ -f "$DNSCRYPT_DIR/dnscrypt.sh" ] || { echo "! dnscrypt.sh not found"; return 1; }
    [ -x "$DNSCRYPT_DIR/dnscrypt-proxy" ] || { echo "! dnscrypt-proxy not found"; return 1; }
    mkdir -p "$TEST_RESULT_DIR" || { echo "! Failed to create test temp directory: $TEST_RESULT_DIR"; return 1; }

    TEST_URL_ARGS=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --no-stop)
                # Do not stop the running service stack before testing.
                # Useful when you want to test against the live stack.
                TEST_NO_STOP=1
                ;;
            --debug|debug)
                echo "! Use only global --debug before the command"
                echo "! Example: ./zapret --debug test"
                return 1
                ;;
            *)
                TEST_URL_ARGS="${TEST_URL_ARGS}${TEST_URL_ARGS:+\n}$1"
                ;;
        esac
        shift
    done

    if [ -n "$TEST_URL_ARGS" ]; then
        TEST_TARGET_URLS="$(printf '%b\n' "$TEST_URL_ARGS")"
    fi

    # ---------------------------------------------------------------------------
    # tcp16-20 suite data — fetched once before strategy loop
    # suite.v2.json  → host list for alive+DPI checks
    # suite.json     → URL list for threshold-download checks
    # ---------------------------------------------------------------------------
    DPI_SUITE_V2_URL="https://raw.githubusercontent.com/hyperion-cs/dpi-checkers/refs/heads/main/ru/tcp-16-20/suite.v2.json"
    DPI_SUITE_URL="https://raw.githubusercontent.com/hyperion-cs/dpi-checkers/refs/heads/main/ru/tcp-16-20/suite.json"
    DPI_SUITE_V2_FILE="$TEST_RESULT_DIR/suite.v2.json"
    DPI_SUITE_FILE="$TEST_RESULT_DIR/suite.json"
    DPI_HOSTS=""      # space-sep list of hosts from suite.v2.json
    DPI_CHECKS=""     # newline-sep list of "id|url|thresholdBytes" from suite.json

    echo "- Downloading tcp16-20 suite files..."
    if download_file "$DPI_SUITE_V2_URL" "$DPI_SUITE_V2_FILE" 2>/dev/null; then
        # Extract hosts: parse JSON field "host": "..."
        DPI_HOSTS="$(grep -o '"host"[[:space:]]*:[[:space:]]*"[^"]*"' "$DPI_SUITE_V2_FILE" 2>/dev/null \
            | sed 's/"host"[[:space:]]*:[[:space:]]*"//;s/"$//' | tr '\n' ' ')"
        echo "- suite.v2.json: $(echo "$DPI_HOSTS" | wc -w | tr -d ' ') hosts loaded"
    else
        echo "! Failed to download suite.v2.json — DPI host checks will be skipped"
    fi

    if download_file "$DPI_SUITE_URL" "$DPI_SUITE_FILE" 2>/dev/null; then
        # Extract id|url|thresholdBytes from suite.json
        # Each entry: { "id": "...", ... "thresholdBytes": N, ... "url": "..." }
        _suite_count=0
        while IFS= read -r _jline; do
            _sid="$(printf '%s' "$_jline" | grep -o '"id"[[:space:]]*:[[:space:]]*"[^"]*"' | head -1 | sed 's/"id"[[:space:]]*:[[:space:]]*"//;s/"$//')"
            _surl="$(printf '%s' "$_jline" | grep -o '"url"[[:space:]]*:[[:space:]]*"[^"]*"' | head -1 | sed 's/"url"[[:space:]]*:[[:space:]]*"//;s/"$//')"
            _sthr="$(printf '%s' "$_jline" | grep -o '"thresholdBytes"[[:space:]]*:[[:space:]]*[0-9]*' | head -1 | sed 's/[^0-9]*//g')"
            [ -n "$_sid" ] && [ -n "$_surl" ] && [ -n "$_sthr" ] || continue
            DPI_CHECKS="${DPI_CHECKS}${_sid}|${_surl}|${_sthr}
"
            _suite_count=$((_suite_count + 1))
        done < "$DPI_SUITE_FILE"
        echo "- suite.json: $_suite_count URL checks loaded"
    else
        echo "! Failed to download suite.json — DPI threshold checks will be skipped"
    fi

    TEST_DEBUG_LOG="$TEST_RESULT_DIR/zapret-test-debug.log"
    [ "$TEST_DEBUG" = "1" ] && : > "$TEST_DEBUG_LOG"

    # Check NFQUEUE availability
    grep -q 'NFQUEUE' /proc/net/ip_tables_targets 2>/dev/null || {
        echo "! NFQUEUE is not available — iptables interception cannot be set up"
        return 1
    }

    if iptables_supported ip6tables mangle && grep -q 'NFQUEUE' /proc/net/ip6_tables_targets 2>/dev/null; then
        HAS_IP6_NFQUEUE=1
    fi

    strategies="$(list_strategies)"
    [ -n "$strategies" ] || { echo "! No strategies found in $STRATEGY_DIR"; return 1; }

    if [ "$TEST_NO_STOP" != "1" ] && {
        service_is_running || nfqws_is_running || \
        dnscrypt_supervisor_is_running || dnscrypt_is_running
    }; then
        echo "- Stopping active service stack before test"
        TEST_RESTORE_STACK=1
        stop_module_service
        sleep 1
    fi

    echo "- Starting DNSCrypt for test"
    nohup sh "$DNSCRYPT_DIR/dnscrypt.sh" >/dev/null 2>&1 &
    DNSCRYPT_STARTED_BY_TEST=1
    sleep 2

    if ! dnscrypt_supervisor_is_running || ! dnscrypt_is_running; then
        echo "! Failed to start DNSCrypt"
        cleanup_test_runtime
        return 1
    fi

    _dns_probe="$(_curl_probe "https://bing.com" "")"
    [ -n "$_dns_probe" ] || _dns_probe="ERR@empty probe output"
    case "$_dns_probe" in
        *"@"*) ;;
        *) _dns_probe="ERR@$_dns_probe" ;;
    esac
    _dns_probe_status="${_dns_probe%%@*}"
    _dns_probe_detail="${_dns_probe#*@}"
    PRECHECK_HTTPS_STATUS="$_dns_probe_status"
    PRECHECK_HTTPS_DETAIL="$_dns_probe_detail"
    _pf_https_label="${_dns_probe_status:-FAIL}"

    echo "- Preflight: HTTPS=$_pf_https_label"
    if [ "$TEST_DEBUG" = "1" ]; then
        {
            echo "[preflight] HTTPS probe status=$_dns_probe_status"
            echo "[preflight] HTTPS probe detail=$_dns_probe_detail"
        } >> "$TEST_DEBUG_LOG"
    fi
    if [ "$_dns_probe_status" != "OK" ]; then
        echo "! Baseline HTTPS probe failed before strategy tests (${_dns_probe_status:-empty-response})"
        echo "  Note: strategy tests will still run — results show what each strategy achieves"
        [ "$TEST_DEBUG" = "1" ] && echo "  debug: $_dns_probe_detail"
    fi

    RESULT_FILE="$TEST_RESULT_DIR/zapret-test-results.$$"
    : > "$RESULT_FILE"

    strat_count="$(printf '%s\n' "$strategies" | grep -c '.')"
    echo "====================================================="
    printf ' Strategy tester — %s strategies\n' "$strat_count"
    echo "====================================================="

    printf '%s\n' "$strategies" | while IFS= read -r strategy_name; do
        [ -n "$strategy_name" ] || continue
        strategy_file="$STRATEGY_DIR/$strategy_name.sh"
        [ -f "$strategy_file" ] || continue

        echo ""
        echo "----------------------------------------------------"
        printf ' [%s]\n' "$strategy_name"
        echo "----------------------------------------------------"

        config=""
        # shellcheck disable=SC1090
        . "$strategy_file" 2>/dev/null
        config="$(printf '%s\n' "$config" | sed \
            -e 's/ --dpi-desync-any-protocol=1 --dpi-desync-fake-quic=/ --dpi-desync-fake-quic=/g' \
            -e 's/ --dpi-desync-fake-quic=/ --dpi-desync-any-protocol=1 --dpi-desync-fake-quic=/g')"

        if [ "$TEST_DEBUG" = "1" ]; then
            {
                echo "[$strategy_name] config=$config"
            } >> "$TEST_DEBUG_LOG"
        fi

        if [ -z "$config" ]; then
            echo "  ! Empty config — skipped"
            printf 'SKIP:0:0:0:0:0:%s\n' "$strategy_name" >> "$RESULT_FILE"
            continue
        fi

        printf '  > Starting nfqws... '
        ensure_zapret_firewall_base 2>/dev/null

        _tcp_ports="$(printf '%s\n' "$config" | grep -oE 'filter-tcp=[0-9,-]+' | \
            sed -e 's/.*=//g' -e 's/,/\n/g' | sort -un)"
        _udp_ports="$(printf '%s\n' "$config" | grep -oE 'filter-udp=[0-9,-]+' | \
            sed -e 's/.*=//g' -e 's/,/\n/g' | sort -un)"

        _add_ipt() {
            _pr="$1"; _pt="$2"
            append_unique_rule iptables mangle "$CHAIN_ZAPRET_POST" \
                -p "$_pr" --dport "$_pt" -j NFQUEUE --queue-num 200 --queue-bypass 2>/dev/null
            append_unique_rule iptables mangle "$CHAIN_ZAPRET_PRE" \
                -p "$_pr" --sport "$_pt" -j NFQUEUE --queue-num 200 --queue-bypass 2>/dev/null
        }
        _add_ip6t() {
            _pr="$1"; _pt="$2"
            [ "$HAS_IP6_NFQUEUE" = "1" ] || return 0
            append_unique_rule ip6tables mangle "$CHAIN_ZAPRET_POST" \
                -p "$_pr" --dport "$_pt" -j NFQUEUE --queue-num 200 --queue-bypass 2>/dev/null
            append_unique_rule ip6tables mangle "$CHAIN_ZAPRET_PRE" \
                -p "$_pr" --sport "$_pt" -j NFQUEUE --queue-num 200 --queue-bypass 2>/dev/null
        }
        for _p in $_tcp_ports; do _add_ipt tcp "$_p"; done
        for _p in $_udp_ports; do _add_ipt udp "$_p"; done
        for _p in $_tcp_ports; do _add_ip6t tcp "$_p"; done
        for _p in $_udp_ports; do _add_ip6t udp "$_p"; done

        "$NFQWS_BIN" --uid=0:0 --bind-fix4 --bind-fix6 --qnum=200 $config >/dev/null 2>&1 &
        _nfqws_pid=$!
        sleep 2
        if ! pid_is_running "$_nfqws_pid"; then
            echo "! nfqws exited early"
            [ "$TEST_DEBUG" = "1" ] && {
                echo "[$strategy_name] nfqws exited early"
            } >> "$TEST_DEBUG_LOG"
            cleanup_zapret_firewall 2>/dev/null
            printf 'SKIP:0:0:0:0:0:0:0:%s\n' "$strategy_name" >> "$RESULT_FILE"
            continue
        fi
        echo "OK (pid $_nfqws_pid)"

        st_ok=0; st_err=0; st_unsup=0; st_dpi_bypassed=0; st_dpi_fail=0; st_thr_ok=0; st_thr_fail=0

        printf '  > HTTP/TLS checks:\n'

        _probe_pids=""
        _url_idx=0
        for _url in $TEST_TARGET_URLS; do
            [ -z "$_url" ] && continue
            _url_idx=$((_url_idx + 1))
            (
                _probe_http="$(_curl_probe "$_url" "")"
                [ -n "$_probe_http" ] || _probe_http="ERR@empty probe output"
                case "$_probe_http" in *"@"*) ;; *) _probe_http="ERR@$_probe_http" ;; esac

                _probe_12="$(_curl_probe "$_url" "12")"
                [ -n "$_probe_12" ] || _probe_12="ERR@empty probe output"
                case "$_probe_12" in *"@"*) ;; *) _probe_12="ERR@$_probe_12" ;; esac

                _probe_13="$(_curl_probe "$_url" "13")"
                [ -n "$_probe_13" ] || _probe_13="ERR@empty probe output"
                case "$_probe_13" in *"@"*) ;; *) _probe_13="ERR@$_probe_13" ;; esac

                printf "%s\n" "$_probe_http|$_probe_12|$_probe_13" > "$TEST_RESULT_DIR/_probe_$$.$_url_idx"
            ) &
            _probe_pids="$_probe_pids $!"
        done

        # ---------------------------------------------------------------------------
        # tcp16-20 DPI host checks (suite.v2.json)
        #   Alive:  HEAD https://<host>/ -m 10
        #   Method1 POST 64KB body -m 15 → if timeout/RST while alive = DPI DETECTED
        #           (means strategy bypassed the block — GOOD)
        #   We report: BYPASSED (DPI detected = strategy works) or FAIL (no DPI or host down)
        # ---------------------------------------------------------------------------
        _dpi_host_idx=0
        if [ -n "$DPI_HOSTS" ]; then
            for _dhost in $DPI_HOSTS; do
                _dpi_host_idx=$((_dpi_host_idx + 1))
                (
                    _dpi_url="https://${_dhost}/"
                    # Alive check: HEAD, 10s timeout
                    _alive_exit=0
                    "$TEST_CURL" -IsSL -m 10 -o /dev/null "$_dpi_url" >/dev/null 2>&1 || _alive_exit=$?
                    # _alive_exit=0 means reachable, 28=timeout, other=conn error
                    if [ "$_alive_exit" -eq 28 ]; then
                        # Alive timed out — host might be down, skip DPI
                        printf 'SKIP\n' > "$TEST_RESULT_DIR/_dpi_$$.$_dpi_host_idx"
                        exit 0
                    fi
                    # POST 64KB random-safe data, 15s timeout
                    # Generate pseudo-random data via /dev/urandom or fallback
                    _post_tmp="$TEST_RESULT_DIR/_post64_$$"
                    if [ -r /dev/urandom ]; then
                        dd if=/dev/urandom of="$_post_tmp" bs=1024 count=64 2>/dev/null
                    else
                        # fallback: fill with zeros
                        dd if=/dev/zero of="$_post_tmp" bs=1024 count=64 2>/dev/null
                    fi
                    _post_exit=0
                    "$TEST_CURL" -sS -m 15 -X POST \
                        --data-binary "@$_post_tmp" \
                        -H 'Content-Type: application/octet-stream' \
                        -o /dev/null "$_dpi_url" 2>/dev/null || _post_exit=$?
                    rm -f "$_post_tmp"
                    # exit 28 = timeout (DPI blocked large POST = bypass needed = strategy works)
                    # exit 0  = succeeded without block (no DPI or DPI didn't trigger)
                    if [ "$_post_exit" -eq 28 ]; then
                        printf 'BYPASSED\n' > "$TEST_RESULT_DIR/_dpi_$$.$_dpi_host_idx"
                    else
                        printf 'FAIL\n' > "$TEST_RESULT_DIR/_dpi_$$.$_dpi_host_idx"
                    fi
                ) &
                _probe_pids="$_probe_pids $!"
            done
        fi

        # ---------------------------------------------------------------------------
        # tcp16-20 threshold checks (suite.json)
        #   Download up to thresholdBytes of the URL, verify received >= threshold
        # ---------------------------------------------------------------------------
        _dpi_thr_idx=0
        if [ -n "$DPI_CHECKS" ]; then
            printf '%s' "$DPI_CHECKS" | while IFS='|' read -r _cid _curl _cthr; do
                [ -n "$_cid" ] || continue
                _dpi_thr_idx=$((_dpi_thr_idx + 1))
                (
                    _thr_tmp="$TEST_RESULT_DIR/_thr_$$.$_dpi_thr_idx"
                    _dl_exit=0
                    # Download up to thresholdBytes+1 bytes, 25s timeout
                    _got="$("$TEST_CURL" -sS -m 25 -L \
                        -H 'Range: bytes=0-'"$_cthr" \
                        -w '%{size_download}' -o /dev/null \
                        "$_curl" 2>/dev/null)" || _dl_exit=$?
                    _got="$(printf '%s' "$_got" | tr -d '[:space:]' | grep -oE '^[0-9]+')"
                    [ -n "$_got" ] || _got=0
                    if [ "$_got" -ge "$_cthr" ]; then
                        printf 'OK\n' > "$_thr_tmp"
                    else
                        printf 'FAIL\n' > "$_thr_tmp"
                    fi
                ) &
                _probe_pids="$_probe_pids $!"
            done
        fi

        # Wait only for probe jobs
        for _pid in $_probe_pids; do
            wait "$_pid" 2>/dev/null
        done

        # Read back HTTP/TLS results
        _url_idx=0
        for _url in $TEST_TARGET_URLS; do
            [ -z "$_url" ] && continue
            _url_idx=$((_url_idx + 1))
            _res_file="$TEST_RESULT_DIR/_probe_$$.$_url_idx"
            if [ -f "$_res_file" ]; then
                IFS='|' read -r _probe_http _probe_12 _probe_13 < "$_res_file"
                rm -f "$_res_file"
            else
                _probe_http="ERR@" _probe_12="ERR@" _probe_13="ERR@"
            fi

            _r_http="${_probe_http%%@*}"
            _r_12="${_probe_12%%@*}"
            _r_13="${_probe_13%%@*}"
            _d_http="${_probe_http#*@}"
            _d_12="${_probe_12#*@}"
            _d_13="${_probe_13#*@}"

            [ -n "$_r_http" ] || _r_http="ERR"
            [ -n "$_r_12" ] || _r_12="ERR"
            [ -n "$_r_13" ] || _r_13="ERR"

            printf '    %-42s  HTTP:%-5s  TLS1.2:%-5s  TLS1.3:%-5s\n' \
                "$_url" "$_r_http" "$_r_12" "$_r_13"

            if [ "$TEST_DEBUG" = "1" ]; then
                {
                    echo "[$strategy_name] url=$_url"
                    echo "[$strategy_name] http=$_r_http detail=$_d_http"
                    echo "[$strategy_name] tls12=$_r_12 detail=$_d_12"
                    echo "[$strategy_name] tls13=$_r_13 detail=$_d_13"
                } >> "$TEST_DEBUG_LOG"
            fi

            for _tok in "$_r_http" "$_r_12" "$_r_13"; do
                case "$_tok" in
                    OK)          st_ok=$((st_ok+1)) ;;
                    ERR|SSL|DNS) st_err=$((st_err+1)) ;;
                    UNSUP)       st_unsup=$((st_unsup+1)) ;;
                esac
            done
        done

        # Read back DPI host results (suite.v2.json)
        if [ -n "$DPI_HOSTS" ] && [ "$_dpi_host_idx" -gt 0 ]; then
            printf '  > tcp16-20 DPI host checks:\n'
            _hi=0
            for _dhost in $DPI_HOSTS; do
                _hi=$((_hi + 1))
                [ "$_hi" -gt "$_dpi_host_idx" ] && break
                _res_file="$TEST_RESULT_DIR/_dpi_$$.$_hi"
                _dpi_r="SKIP"
                if [ -f "$_res_file" ]; then
                    read -r _dpi_r < "$_res_file"
                    rm -f "$_res_file"
                fi
                printf '    %-38s  DPI:%s\n' "$_dhost" "$_dpi_r"
                case "$_dpi_r" in
                    BYPASSED) st_dpi_bypassed=$((st_dpi_bypassed+1)) ;;
                    FAIL)     st_dpi_fail=$((st_dpi_fail+1)) ;;
                esac
            done
        fi

        # Read back threshold results (suite.json)
        if [ -n "$DPI_CHECKS" ] && [ "$_dpi_thr_idx" -gt 0 ]; then
            printf '  > tcp16-20 threshold checks:\n'
            _ti=0
            printf '%s' "$DPI_CHECKS" | while IFS='|' read -r _cid _curl _cthr; do
                [ -n "$_cid" ] || continue
                _ti=$((_ti + 1))
                [ "$_ti" -gt "$_dpi_thr_idx" ] && break
                _res_file="$TEST_RESULT_DIR/_thr_$$.$_ti"
                _thr_r="FAIL"
                if [ -f "$_res_file" ]; then
                    read -r _thr_r < "$_res_file"
                    rm -f "$_res_file"
                fi
                printf '    %-12s  %-38s  %s\n' "$_cid" "$(printf '%s' "$_curl" | cut -c1-38)" "$_thr_r"
                case "$_thr_r" in
                    OK)   st_thr_ok=$((st_thr_ok+1)) ;;
                    FAIL) st_thr_fail=$((st_thr_fail+1)) ;;
                esac
            done
        fi

        kill -TERM "$_nfqws_pid" 2>/dev/null || true
        sleep 1
        kill -KILL "$_nfqws_pid" 2>/dev/null || true
        cleanup_zapret_firewall 2>/dev/null

        # Total score = HTTP_OK + DPI_BYPASSED + THRESHOLD_OK
        _total=$(( st_ok + st_dpi_bypassed + st_thr_ok ))
        printf '  > Score: HTTP_OK=%s  ERR=%s  UNSUP=%s  DPI_BYPASSED=%s  DPI_FAIL=%s  THR_OK=%s  THR_FAIL=%s  TOTAL=%s\n' \
            "$st_ok" "$st_err" "$st_unsup" "$st_dpi_bypassed" "$st_dpi_fail" "$st_thr_ok" "$st_thr_fail" "$_total"
        printf 'OK:%s:%s:%s:%s:%s:%s:%s:%s\n' \
            "$st_ok" "$st_err" "$st_unsup" "$st_dpi_bypassed" "$st_dpi_fail" "$st_thr_ok" "$st_thr_fail" "$strategy_name" \
            >> "$RESULT_FILE"
    done

    # ---------------------------------------------------------------------------
    # Summary table sorted by HTTP OK desc
    # ---------------------------------------------------------------------------
    echo ""
    echo "====================================================="
    echo " Results summary  (sorted by total score)"
    echo "====================================================="
    printf '  %-26s  %5s  %5s  %5s  %7s  %7s  %7s\n' \
        "Strategy" "HTTP" "ERR" "UNSUP" "DPI_BYP" "THR_OK" "TOTAL"
    echo "  ---------------------------------------------------------------------------"
    # Sort by TOTAL = col8 (HTTP_OK + DPI_BYPASSED + THR_OK) — compute dynamically
    sort -t: -k2 -rn "$RESULT_FILE" | while IFS=: read -r _t _ok _err _unsup _dpibp _dpif _throk _thrf _nm; do
        if [ "$_t" = "SKIP" ]; then
            printf '  %-26s  SKIPPED\n' "$_nm"
        else
            _tot=$(( _ok + _dpibp + _throk ))
            printf '  %-26s  %5s  %5s  %5s  %7s  %7s  %7s\n' \
                "$_nm" "$_ok" "$_err" "$_unsup" "$_dpibp" "$_throk" "$_tot"
        fi
    done

    # Pick best: max TOTAL score
    best_strategy=""
    best_ok=-1
    best_ping=-1
    while IFS=: read -r _t _ok _err _unsup _dpibp _dpif _throk _thrf _nm; do
        [ "$_t" = "SKIP" ] && continue
        _tot=$(( _ok + _dpibp + _throk ))
        if [ "$_tot" -gt "$best_ok" ] || \
           { [ "$_tot" -eq "$best_ok" ] && [ "$_dpibp" -gt "$best_ping" ]; }; then
            best_ok="$_tot"
            best_ping="$_dpibp"
            best_strategy="$_nm"
        fi
    done < "$RESULT_FILE"
    rm -f "$RESULT_FILE"
    rm -f "$DPI_SUITE_V2_FILE" "$DPI_SUITE_FILE" 2>/dev/null || true

    cleanup_test_runtime
    trap - INT TERM

    echo ""
    if [ -n "$best_strategy" ] && [ "$best_ok" -ge 0 ]; then
        echo "★  Best strategy: $best_strategy  (Total score: $best_ok  DPI bypassed: $best_ping)"
        if [ "$best_ok" -eq 0 ] && [ "$PRECHECK_HTTPS_STATUS" != "OK" ]; then
            echo "! All strategies scored 0, and baseline HTTPS was already failing before strategy checks."
            echo "! Most likely the issue is outside the strategy set: DNS/DNSCrypt/routing/network environment."
            [ "$TEST_DEBUG" = "1" ] && echo "! Baseline detail: $PRECHECK_HTTPS_DETAIL"
        fi
        if [ "$TEST_DEBUG" = "1" ]; then
            echo "- Debug log: $TEST_DEBUG_LOG"
        fi
    else
        echo "! No strategy produced any successful connections."
        if [ "$TEST_DEBUG" = "1" ]; then
            echo "- Debug log: $TEST_DEBUG_LOG"
        fi
        return 1
    fi
}

while [ $# -gt 0 ]; do
    case "$1" in
        --debug)
            CLI_DEBUG=1
            shift
            ;;
        --)
            shift
            break
            ;;
        *)
            break
            ;;
    esac
done

export CLI_DEBUG
[ "$CLI_DEBUG" = "1" ] && set -x

case "$1" in
    ""|help|-help|--help|h|--h|-h) command_info ;;
    start) start_service ;;
    stop) stop_service ;;
    restart) restart_service ;;
    status) status_service ;;
    running) module_stack_is_running ;;
    strategy) strategy_command "$2" ;;
    import-strategy) import_strategy "$2" ;;
    test) shift; test_command "$@" ;;
    ipset-update) ipset_update ;;
    custom) shift; custom_command "$@" ;;
    exclude) shift; exclude_command "$@" ;;
    search) shift; search_command "$@" ;;
    setup) setup_command "$2" "$3" "$4" ;;
    *) command_info ;;
esac
